---
import { z } from "zod";
import RecipeCard from "@/components/recipes/RecipeCard.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { PLUGIN_COLUMNS, pluginRowSchema } from "@/lib/plugins";
import { PRIMARY_DAW_IDS } from "@/lib/primary-daw";
import {
  choiceFromProgress,
  findRecipe,
  PROGRESS_COLUMNS,
  progressRowSchema,
  RECIPE_COLUMNS,
  recipeFromRow,
  recipeRowSchema,
  RECIPES,
  selectTool,
} from "@/lib/recipes";
import { createClient } from "@/lib/supabase";
import { TRACK_COLUMNS, TRACK_STAGES, trackRowSchema } from "@/lib/tracks";

const id = z.uuid().safeParse(Astro.params.id);
const supabase = createClient(Astro.request.headers, Astro.cookies);
const result =
  id.success && supabase ? await supabase.from("tracks").select(TRACK_COLUMNS).eq("id", id.data).maybeSingle() : null;

const parsed = trackRowSchema.safeParse(result?.data);
const track = parsed.success ? parsed.data : null;
const loadFailed = Boolean(result?.error) || (Boolean(result?.data) && !parsed.success);
if (!track) {
  Astro.response.status = loadFailed ? 500 : 404;
}

const showInvalid = Astro.url.searchParams.get("error") === "invalid_track";
const showInvalidRecipe = Astro.url.searchParams.get("error") === "invalid_recipe_action";

// A failed read must not look like "no plugins", or the card would wrongly offer the native tool.
const isMiks = track?.stage === "miks";
const ownRecipeListColumns = `${RECIPE_COLUMNS}, created_at`;
const [pluginsResult, profileResult, progressResult, ownResult] =
  isMiks && supabase
    ? await Promise.all([
        supabase.from("plugins").select(PLUGIN_COLUMNS),
        supabase.from("daw_profiles").select("daw_id").maybeSingle(),
        supabase.from("track_recipe_progress").select(PROGRESS_COLUMNS).eq("track_id", track.id),
        supabase.from("recipes").select(ownRecipeListColumns).order("created_at", { ascending: false }),
      ])
    : [null, null, null, null];

const plugins = z.array(pluginRowSchema).safeParse(pluginsResult?.data);
const progressRows = z.array(progressRowSchema).safeParse(progressResult?.data);
const ownRows = z.array(recipeRowSchema).safeParse(ownResult?.data);
const storedDaw: unknown = profileResult?.data?.daw_id;
const daw = z
  .enum(PRIMARY_DAW_IDS)
  .nullable()
  .safeParse(storedDaw ?? null);

const requestedRecipeId = Astro.url.searchParams.get("recipe");
const stored = progressRows.success ? progressRows.data : [];
const recipes = [...RECIPES, ...(ownRows.success ? ownRows.data.map(recipeFromRow) : [])];
const listed =
  recipes.find((candidate) => candidate.id === requestedRecipeId) ??
  recipes.find((candidate) => stored.some((row) => row.recipe_id === candidate.id));
const resolved = listed && supabase ? await findRecipe(supabase, listed.id) : null;
const recipe = resolved === "error" ? null : resolved;
const recipeLoadFailed =
  isMiks &&
  (Boolean(pluginsResult?.error ?? profileResult?.error ?? progressResult?.error ?? ownResult?.error) ||
    resolved === "error" ||
    !plugins.success ||
    !progressRows.success ||
    !ownRows.success ||
    !daw.success);
const progress = stored.find((row) => row.recipe_id === recipe?.id);
const choice = choiceFromProgress(progress);
const selection =
  recipe && plugins.success && daw.success
    ? selectTool({ plugins: plugins.data, dawId: daw.data, requiredType: recipe.requiredType, choice })
    : null;

const field = "rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white [&>option]:text-black";
const button = "rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm transition-colors hover:bg-white/20";
---

<AppLayout title={track?.name ?? (loadFailed ? "Track could not be loaded" : "Track not found")}>
  {track ? (
    <>
      <form method="POST" action={`/api/tracks/${track.id}`} class="flex flex-col gap-2 sm:flex-row">
        <label class="sr-only" for="track-name">
          Track name
        </label>
        <input id="track-name" name="name" required maxlength="100" value={track.name} class:list={[field, "grow"]} />
        <label class="sr-only" for="track-stage">
          Stage
        </label>
        <select id="track-stage" name="stage" class:list={field}>
          {TRACK_STAGES.map((stage) => (
            <option value={stage.id} selected={stage.id === track.stage}>
              {stage.label}
            </option>
          ))}
        </select>
        <button type="submit" class:list={button}>
          Save
        </button>
      </form>
      {showInvalid && (
        <p role="alert" class="mt-2 text-sm text-red-200">
          Enter a track name up to 100 characters and choose a stage.
        </p>
      )}
      {!isMiks && <p class="mt-6 text-sm text-blue-100/80">Switch this track to Miks to use a recipe.</p>}
      {isMiks && (
        <details open={!recipe} class="mt-6 rounded-xl border border-white/10 bg-white/5 p-3">
          <summary class="cursor-pointer text-sm font-medium">Potrzebuję przepisu</summary>
          <ul class="mt-2 flex flex-col gap-1 text-sm">
            {recipes.map((item) => (
              <li>
                <a
                  href={`/tracks/${track.id}?recipe=${item.id}`}
                  class="text-purple-200 hover:text-white hover:underline"
                >
                  {item.intent}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
      {showInvalidRecipe && (
        <p role="alert" class="mt-2 text-sm text-red-200">
          That change could not be saved. Choose a tool or a step from the card.
        </p>
      )}
      {recipeLoadFailed ? (
        <p role="alert" class="mt-6 text-sm text-red-200">
          The recipe could not be loaded. Refresh the page to try again.
        </p>
      ) : (
        isMiks &&
        recipe &&
        selection && (
          <RecipeCard
            trackId={track.id}
            recipe={recipe}
            selection={selection}
            choice={choice}
            completedSteps={progress?.completed_steps ?? []}
            hasDaw={daw.success && daw.data !== null}
          />
        )
      )}
    </>
  ) : (
    <a href="/tracks" class="text-purple-200 hover:text-white hover:underline">
      Back to tracks
    </a>
  )}
</AppLayout>
