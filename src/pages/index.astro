---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout>
  <main class="bg-cosmic flex min-h-screen items-center justify-center p-4 text-center text-white">
    <div class="max-w-2xl">
      <h1 class="mb-6 text-5xl font-bold">Mixing Cookbook</h1>
      <p class="mb-10 text-lg text-blue-100/80">
        Turn a mixing intent into one concrete action: a checklist, a settings screenshot, and the right tool from your
        own plugins or your DAW.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        {user ? (
          <a
            href="/dashboard"
            class="rounded-lg bg-white px-6 py-3 font-semibold text-black transition-colors hover:bg-blue-100"
          >
            Open dashboard
          </a>
        ) : (
          <>
            <a
              href="/auth/signin"
              class="rounded-lg bg-white px-6 py-3 font-semibold text-black transition-colors hover:bg-blue-100"
            >
              Sign in
            </a>
            <a
              href="/auth/signup"
              class="rounded-lg border border-white/20 bg-white/10 px-6 py-3 font-semibold transition-colors hover:bg-white/20"
            >
              Create account
            </a>
          </>
        )}
      </div>
    </div>
  </main>
</Layout>
